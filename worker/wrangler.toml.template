# Template — deploy.sh copies this to wrangler.toml on first run and fills
# the @@DB_ID@@ placeholder. Commit the template; keep wrangler.toml gitignored
# so the D1 database ID stays out of git history.

name = "phantom-click-bridge"
main = "src/index.ts"
compatibility_date = "2024-12-01"

# Custom route. Once this Worker is deployed, requests to
# https://bridge.z1nexusn1.org/* hit the Worker instead of the cloudflared
# tunnel — CF gives Worker routes precedence over CNAMEs in the same zone.
# (Top-level key on purpose; once [[d1_databases]] is opened below, every
# subsequent line lives under that table until another section header.)
routes = [
    { pattern = "bridge.z1nexusn1.org/*", zone_name = "z1nexusn1.org" },
]

[observability]
enabled = true

# Bind the D1 database. ID is filled by deploy.sh after `wrangler d1 create`.
[[d1_databases]]
binding = "DB"
database_name = "phantom-click-tokens"
database_id = "@@DB_ID@@"
