# Copy this file to .env (never commit .env) and fill in your keys.
# LuLuBot reads these at launch; you can also set them via ⚙ API Key in the app.

# ── Pick ONE provider ────────────────────────────────────────────────────────

# Claude (Anthropic) — default when no key / model override is set
# Get key: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Gemini (Google AI Studio) — set PHANTOM_MODEL and PHANTOM_PROVIDER too
# Get key: https://aistudio.google.com/
# GEMINI_API_KEY=AIza...
# PHANTOM_MODEL=gemini-2.5-flash
# PHANTOM_PROVIDER=google

# Kimi K2 (Moonshot, OpenAI-compatible) — cheap, multimodal
# Get key: https://platform.moonshot.cn/
# ANTHROPIC_API_KEY=sk-...   # Moonshot key reuses this env name
# PHANTOM_MODEL=kimi-k2.5
# PHANTOM_PROVIDER=moonshot

# ── Optional overrides ───────────────────────────────────────────────────────

# Override default model for any provider
# PHANTOM_MODEL=claude-opus-4-7

# Override API base URL (e.g. for a self-hosted proxy)
# PHANTOM_API_BASE=https://your-proxy.example.com
