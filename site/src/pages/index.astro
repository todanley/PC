---
// Single-page CN landing for 噜噜机器人. Static; no JS framework needed.
// Download URLs point at the R2 public bucket served on downloads.z1nexusn1.org.
// `version.json` (also served from R2) carries the canonical current version
// string; the CI build script rewrites it on every release. The hardcoded
// fallback below is what the site shows when the manifest hasn't been
// fetched yet (or when the user is offline).
const FALLBACK_VERSION = "0.2.0";
// Two different download backends — both reach CN via Cloudflare's edge:
//   • Mac → R2 public bucket. Static zip uploaded by CI on every tag push.
//   • Win → Worker proxy. The Worker re-fetches the asset from the private
//     GitHub Release (with the operator's PAT) and streams it back through
//     CF's CDN. This sidesteps GitHub's CN reachability quirks and works
//     today without R2 enabled. The Mac side will likely migrate to the
//     same Worker-proxy pattern once we add a Mac endpoint.
const MAC_URL = "https://downloads.z1nexusn1.org/LuLuBot-mac-latest.zip";
const WIN_URL = "https://bridge.z1nexusn1.org/download/LuLuBot.exe";
const VERSION_JSON_URL = "https://downloads.z1nexusn1.org/version.json";
---
<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>噜噜机器人 — 让 AI 替你操作电脑</title>
<meta name="description" content="一句话描述任务，噜噜机器人替你点击、输入、滚动 — 自动完成日常电脑工作。" />
<meta property="og:title" content="噜噜机器人" />
<meta property="og:description" content="让 AI 替你操作电脑" />
<style>
  :root {
    --bg: #0b0d12;
    --bg-2: #11141b;
    --fg: #e6e8eb;
    --fg-dim: #9ca3af;
    --accent: #5a8dff;
    --accent-hi: #7aa3ff;
    --border: #1f2530;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; background: var(--bg); color: var(--fg);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC",
                 "Microsoft YaHei", "Helvetica Neue", sans-serif;
    line-height: 1.55; -webkit-font-smoothing: antialiased; }
  a { color: var(--accent); text-decoration: none; }
  a:hover { color: var(--accent-hi); }

  .wrap { max-width: 920px; margin: 0 auto; padding: 64px 24px 96px; }
  header { display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 64px; }
  .logo { font-weight: 700; font-size: 22px; }
  .logo span { color: var(--accent); }
  nav a { margin-left: 28px; color: var(--fg-dim); font-size: 15px; }
  nav a:hover { color: var(--fg); }

  .hero h1 { font-size: clamp(36px, 6vw, 56px); line-height: 1.15;
    margin: 0 0 18px; letter-spacing: -0.02em; }
  .hero p.sub { font-size: 20px; color: var(--fg-dim); max-width: 640px;
    margin: 0 0 36px; }

  .cta { display: flex; flex-wrap: wrap; gap: 14px; margin-bottom: 14px; }
  .btn { display: inline-flex; align-items: center; gap: 10px;
    padding: 14px 22px; border-radius: 12px; font-weight: 600; font-size: 16px;
    border: 1px solid transparent; transition: transform .08s ease;
    cursor: pointer; user-select: none; }
  .btn:active { transform: translateY(1px); }
  .btn-primary { background: var(--accent); color: white; }
  .btn-primary:hover { background: var(--accent-hi); color: white; }
  .btn-secondary { background: transparent; color: var(--fg);
    border: 1px solid var(--border); }
  .btn-secondary:hover { border-color: var(--accent); color: var(--accent-hi); }
  .ver { color: var(--fg-dim); font-size: 13px; margin-top: 10px; }

  section { margin-top: 88px; }
  h2 { font-size: 28px; margin: 0 0 24px; letter-spacing: -0.01em; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px; }
  .card { background: var(--bg-2); border: 1px solid var(--border);
    border-radius: 14px; padding: 22px 22px 18px; }
  .card h3 { margin: 0 0 8px; font-size: 17px; }
  .card p { margin: 0; color: var(--fg-dim); font-size: 15px; }

  .examples li { margin-bottom: 10px; color: var(--fg-dim);
    font-family: "SF Mono", Menlo, Consolas, monospace; font-size: 14px; }
  .examples li::marker { color: var(--accent); }
  .examples li b { color: var(--fg); font-weight: 600;
    font-family: inherit; font-size: 14px; }

  details { border-top: 1px solid var(--border); padding: 18px 0; }
  details summary { cursor: pointer; font-weight: 600; font-size: 16px;
    list-style: none; }
  details summary::-webkit-details-marker { display: none; }
  details summary::after { content: " +"; color: var(--accent); }
  details[open] summary::after { content: " −"; }
  details p { color: var(--fg-dim); font-size: 15px; margin: 10px 0 0; }

  footer { margin-top: 96px; padding-top: 24px; border-top: 1px solid var(--border);
    color: var(--fg-dim); font-size: 13px; display: flex;
    justify-content: space-between; flex-wrap: wrap; gap: 12px; }

  @media (max-width: 540px) {
    .wrap { padding: 40px 20px 64px; }
    header { margin-bottom: 48px; }
    nav a { margin-left: 18px; }
    section { margin-top: 64px; }
  }
</style>
</head>
<body>
<div class="wrap">
  <header>
    <div class="logo">噜噜<span>机器人</span></div>
    <nav>
      <a href="#features">功能</a>
      <a href="#examples">示例</a>
      <a href="#faq">常见问题</a>
    </nav>
  </header>

  <section class="hero">
    <h1>让 AI 替你<br/>操作电脑。</h1>
    <p class="sub">
      输入一句话描述任务，噜噜机器人替你点击、输入、滚动、跨应用切换 —
      从打开浏览器，到批量操作社交账号，全程无需你动手。
    </p>
    <div class="cta">
      <a class="btn btn-primary" href={MAC_URL} download>
        下载 macOS 版
      </a>
      <a class="btn btn-secondary" href={WIN_URL} download>
        下载 Windows 版
      </a>
    </div>
    <div class="ver" id="ver">当前版本 v{FALLBACK_VERSION}</div>
  </section>

  <section id="features">
    <h2>核心能力</h2>
    <div class="grid">
      <div class="card">
        <h3>视觉理解界面</h3>
        <p>不依赖网页 DOM 或脚本注入 — 像人一样看着屏幕做决定，几乎所有桌面应用都能驱动。</p>
      </div>
      <div class="card">
        <h3>一句话下任务</h3>
        <p>无需配置流程，无需编程。把目标用自然语言写出来，剩下的交给机器人。</p>
      </div>
      <div class="card">
        <h3>仿真人操作</h3>
        <p>贝塞尔曲线鼠标轨迹、随机停顿、对数正态打字节奏 — 反检测友好。</p>
      </div>
      <div class="card">
        <h3>预付费按量计费</h3>
        <p>购买令牌即用即扣，余额跑完自动停止。无订阅，无续费陷阱。</p>
      </div>
    </div>
  </section>

  <section id="examples">
    <h2>能做什么</h2>
    <ul class="examples">
      <li><b>「打开抖音，关注 10 个随机账号」</b> — 自动进入推荐视频流，识别 +关注 按钮，逐条完成</li>
      <li><b>「在淘宝搜索 XX，把前 5 个商品截图保存到桌面」</b> — 浏览、定位、批量截图</li>
      <li><b>「打开微信，把『工作群』里今天的图片全部下载」</b> — 跨应用切换 + 批量操作</li>
      <li><b>「填写 NSW 驾考预约改期表单，选最早可用时段」</b> — 表单导航 + 条件判断</li>
    </ul>
  </section>

  <section id="faq">
    <h2>常见问题</h2>

    <details>
      <summary>需要什么样的电脑？</summary>
      <p>macOS 11 及以上的 Mac（Apple Silicon 或 Intel），或 Windows 10/11 的 PC。</p>
    </details>
    <details>
      <summary>会不会传我的数据到服务器？</summary>
      <p>每一步只把当前屏幕截图发送给 AI 模型推断下一步动作。截图不长期保存，不用于训练。</p>
    </details>
    <details>
      <summary>怎么收费？</summary>
      <p>预付费令牌制：购买一个令牌（例如 ¥30），余额随每次调用按量扣减；用完前都可以使用。</p>
    </details>
    <details>
      <summary>第一次打开提示「无法验证开发者」？</summary>
      <p>macOS：右键 .app → 选「打开」，系统提示时再点「打开」。Windows：SmartScreen 弹窗 → 点「更多信息」→「仍要运行」。</p>
    </details>
    <details>
      <summary>怎么联系？</summary>
      <p>微信 / Lark / 邮件 — 联系方式即将公布。</p>
    </details>
  </section>

  <footer>
    <div>© 2026 噜噜机器人</div>
    <div>v<span id="ver-foot">{FALLBACK_VERSION}</span></div>
  </footer>
</div>

<script type="module" define:vars={{ VERSION_JSON_URL }}>
  // Best-effort current version pull. Silent on any failure — falls back to
  // the build-time literal already in the markup.
  try {
    const r = await fetch(VERSION_JSON_URL, { cache: "no-cache" });
    if (r.ok) {
      const { version } = await r.json();
      if (version) {
        document.getElementById("ver").textContent = "当前版本 v" + version;
        document.getElementById("ver-foot").textContent = version;
      }
    }
  } catch {}
</script>
</body>
</html>
